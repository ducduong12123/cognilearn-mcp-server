# --- MCP memory server (src/memory_mcp_server.py) ---
APP_NAME=cognilearn-mcp
PORT=8002

# Supabase project used as the memory store. Leave both empty to run with the
# in-memory store (useful for local development and MCP Inspector sessions).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEMORY_TABLE=memories

# Optional fallback learner id (UUID) when a client sends no X-User-Id header.
DEFAULT_USER_ID=

# --- Embedding-based memory service and question-bank scripts (src/core, src/script) ---
GOOGLE_API_KEY=
SUPABASE_SERVICE_KEY=
